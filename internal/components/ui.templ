package components

import "boilerplate/internal/domain"

templ CSRFField(token string) {
	<input type="hidden" name="_csrf" value={ token }/>
}

templ FlashBanner(flashType, message string) {
	if message != "" {
		<div class={ "flash", templ.KV("flash-success", flashType == "success"), templ.KV("flash-info", flashType == "info"), templ.KV("flash-error", flashType != "success" && flashType != "info") } role="status">
			if flashType == "success" {
				@Icon("check", 16)
			} else {
				@Icon("alert", 16)
			}
			<span>{ message }</span>
		</div>
	}
}

templ FormError(msg string) {
	if msg != "" {
		<div class="flash flash-error" role="alert">
			@Icon("alert", 16)
			<span>{ msg }</span>
		</div>
	}
}

templ TextField(id, label, name, inputType, value, autocomplete, placeholder, errMsg string) {
	<div class="field">
		<label class="field-label" for={ id }>{ label }</label>
		<input class={ "input", templ.KV("input-invalid", errMsg != "") } id={ id } name={ name } type={ inputType } value={ value } autocomplete={ autocomplete } placeholder={ placeholder }/>
		if errMsg != "" {
			<p class="field-error">{ errMsg }</p>
		}
	</div>
}

templ PasswordField(id, label, name, autocomplete, errMsg string) {
	<div class="field">
		<label class="field-label" for={ id }>{ label }</label>
		<div class="input-wrap">
			<input class={ "input", templ.KV("input-invalid", errMsg != "") } id={ id } name={ name } type="password" autocomplete={ autocomplete } placeholder="At least 8 characters" data-password-input/>
			<button type="button" class="input-trailing" data-password-toggle aria-label="Show password">
				<span class="pw-show">@Icon("eye", 16)</span>
				<span class="pw-hide">@Icon("eye-off", 16)</span>
			</button>
		</div>
		if errMsg != "" {
			<p class="field-error">{ errMsg }</p>
		}
	</div>
}

templ StatCard(icon, label, value, sub, countTo string, delay int) {
	<div class="card stat-card" data-reveal data-reveal-delay={ delay }>
		<div class="stat-top">
			<p class="stat-label">{ label }</p>
			<span class="stat-icon">@Icon(icon, 18)</span>
		</div>
		if countTo != "" {
			<p class="stat-value" data-count-to={ countTo }>0</p>
		} else {
			<p class="stat-value">{ value }</p>
		}
		if sub != "" {
			<p class="stat-sub">{ sub }</p>
		}
	</div>
}

templ Badge(text, variant string) {
	<span class={ "badge", "badge-" + variant }>{ text }</span>
}

// Avatar renders the user's photo when one was uploaded, otherwise the
// initials fallback. data-avatar-slot lets avatar.js swap every visible
// avatar in place right after an upload.
templ Avatar(url, initials string) {
	<span class="avatar" data-avatar-slot>
		if url != "" {
			<img class="avatar-img" src={ url } alt="" data-avatar-img/>
		} else {
			{ initials }
		}
	</span>
}

templ EmptyState(icon, title, text string) {
	<div class="empty">
		<span class="empty-icon">@Icon(icon, 22)</span>
		<p class="empty-title">{ title }</p>
		<p class="empty-text">{ text }</p>
	</div>
}

templ PageHeader(title, sub string, action templ.Component) {
	<div class="page-header" data-reveal>
		<div class="page-header-copy">
			<h2 class="page-title">{ title }</h2>
			if sub != "" {
				<p class="page-sub">{ sub }</p>
			}
		</div>
		if action != nil {
			@action
		}
	</div>
}

// Breadcrumb renders an ARIA breadcrumb trail above the page header. The last
// item is always the current page; earlier items render as links.
templ Breadcrumb(items []Crumb) {
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<ol>
			for i, c := range items {
				<li>
					if i < len(items)-1 {
						<a href={ c.Href }>
							if c.Icon != "" {
								@Icon(c.Icon, 14)
								<span class="sr-only">{ c.Label }</span>
							} else {
								{ c.Label }
							}
						</a>
					} else {
						<span aria-current="page">{ c.Label }</span>
					}
				</li>
			}
		</ol>
	</nav>
}

// Button renders a themed button or, when Href is set, a link styled as one.
templ Button(p ButtonProps) {
	if p.Href != "" {
		<a href={ p.Href } class={ buttonClass(p) }>
			@ButtonLabel(p)
		</a>
	} else {
		<button type={ buttonType(p) } class={ buttonClass(p) } disabled?={ p.Disabled }>
			@ButtonLabel(p)
		</button>
	}
}

templ ButtonLabel(p ButtonProps) {
	if p.Icon != "" {
		@Icon(p.Icon, 16)
	}
	{ p.Label }
}

// Dropdown renders a small toggle button with a link menu, for selects such
// as filters. The Selected item is highlighted as the current choice.
templ Dropdown(p DropdownProps) {
	<div class="dropdown-wrap" data-dropdown>
		<button
			type="button"
			class="btn btn-secondary btn-sm"
			data-dropdown-toggle
			aria-haspopup="menu"
			aria-expanded="false"
			aria-label={ p.Label }
		>
			<span>{ p.Label }</span>
			@Icon("chevron-down", 14)
		</button>
		<div class={ "dropdown", templ.KV("dropdown-up", p.Align == DropdownUp), templ.KV("dropdown-right", p.Align == DropdownRight) } role="menu">
			for _, item := range p.Items {
				<a
					href={ item.Href }
					class={ "dropdown-item", templ.KV("active", item.Selected) }
					role="menuitem"
				>
					if item.Icon != "" {
						@Icon(item.Icon, 16)
					}
					<span>{ item.Label }</span>
				</a>
			}
		</div>
	</div>
}

templ ErrorPage(code int, title, detail, theme string, user *domain.User) {
	@Base(ErrorPageTitle(code), theme, "error-body", nil, nil, errorContent(code, title, detail, user))
}

templ errorContent(code int, title, detail string, user *domain.User) {
	<main class="error-wrap">
		<a class="brand" href="/">
			@BrandMark(30)
			<span class="brand-name">bara</span>
		</a>
		<p class="error-code">{ code }</p>
		<h1 class="error-title">{ title }</h1>
		<p class="error-detail">{ detail }</p>
		<div class="error-actions">
			if user != nil {
				if user.IsAdmin() {
					@Button(ButtonProps{Label: "Back to dashboard", Href: "/admin"})
				} else {
					@Button(ButtonProps{Label: "Back to dashboard", Href: "/dashboard"})
				}
			} else {
				@Button(ButtonProps{Label: "Back to home", Href: "/"})
			}
		</div>
	</main>
}
