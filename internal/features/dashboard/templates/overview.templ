package templates

import (
	"strconv"

	"boilerplate/internal/components"
)

templ OverviewContent(d OverviewData) {
	@components.PageHeader(d.Greeting, "Here's what's happening on your account.", nil)
	if d.FlashMsg != "" {
		@components.FlashBanner(d.FlashType, d.FlashMsg)
	}
	<div class="stat-grid">
		@components.StatCard("activity", "Total sign-ins", strconv.FormatInt(d.SignInCount, 10), "Since your first login", strconv.FormatInt(d.SignInCount, 10), 0)
		@components.StatCard("clock", "Last sign-in", d.LastSignIn, "", "", 1)
		@components.StatCard("user", "Member since", components.FormatDate(d.MemberSince), components.TimeAgo(d.MemberSince), "", 2)
		@components.StatCard("shield-check", "Account status", "Active", "Full access", "", 3)
	</div>
	<div class="dash-grid">
		<div class="card table-card" data-reveal data-reveal-delay="2">
			<div class="card-head">
				<div>
					<h3 class="card-title">Recent sign-ins</h3>
					<p class="card-sub">The latest sessions created on this account.</p>
				</div>
				<a class="btn btn-secondary btn-sm" href="/settings">Manage sessions</a>
			</div>
			if len(d.Recent) == 0 {
				@components.EmptyState("activity", "No sign-ins yet", "Sign-in activity will show up here after you log in from a device.")
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Device</th>
								<th>IP address</th>
								<th>When</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range d.Recent {
								<tr>
									<td>
										<span class="cell-main">
											<span class="quick-icon">@components.Icon("monitor", 15)</span>
											{ components.SessionLabel(s.UserAgent) }
										</span>
									</td>
									<td class="mono">{ s.IP }</td>
									<td>{ components.TimeAgo(s.CreatedAt) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
		<div class="card" data-reveal data-reveal-delay="3">
			<div class="card-head">
				<div>
					<h3 class="card-title">Quick actions</h3>
					<p class="card-sub">Common account tasks.</p>
				</div>
			</div>
			<nav class="quick-list" aria-label="Quick actions">
				<a href="/settings">
					<span class="quick-icon">@components.Icon("user", 16)</span>
					<span>Edit account information</span>
					@components.Icon("arrow-right", 15)
				</a>
				<a href="/settings#password">
					<span class="quick-icon">@components.Icon("key", 16)</span>
					<span>Change password</span>
					@components.Icon("arrow-right", 15)
				</a>
				<a href="/">
					<span class="quick-icon">@components.Icon("zap", 16)</span>
					<span>Back to the landing page</span>
					@components.Icon("arrow-right", 15)
				</a>
			</nav>
		</div>
	</div>
}
