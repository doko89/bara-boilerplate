package templates

import (
	"fmt"

	"boilerplate/internal/components"
	"boilerplate/internal/domain"
)

templ UsersContent(d UsersData) {
	@components.PageHeader("Users", "Everyone with an account.", nil)
	if d.FlashMsg != "" {
		@components.FlashBanner(d.FlashType, d.FlashMsg)
	}
	<div class="card table-card" data-reveal data-reveal-delay="1">
		if len(d.Users) == 0 {
			@components.EmptyState("users", "No users yet", "New accounts will appear here as soon as people register.")
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>User</th>
							<th>Role</th>
							<th>Status</th>
							<th>Joined</th>
							<th class="th-actions">Action</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range d.Users {
							<tr>
								<td>
									<div class="cell-user">
										@components.Avatar(u.AvatarURL, u.Initials())
										<div class="cell-user-meta">
											<span class="cell-user-name">{ u.Name }</span>
											<span class="cell-user-email">{ u.Email }</span>
										</div>
									</div>
								</td>
								<td>
									if u.IsAdmin() {
										@components.Badge("Admin", "red")
									} else {
										@components.Badge("User", "gray")
									}
								</td>
								<td>
									if u.IsActive {
										@components.Badge("Active", "green")
									} else {
										@components.Badge("Inactive", "gray")
									}
								</td>
								<td>{ components.FormatDate(u.CreatedAt) }</td>
								<td class="cell-actions">
									@userActions(d, u)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ userActions(d UsersData, u domain.User) {
	if u.ID == d.CurrentUserID {
		@components.Badge("You", "gray")
	} else {
		<div class="row-actions">
			<form method="post" action={ fmt.Sprintf("/admin/users/%d/role", u.ID) }>
				@components.CSRFField(d.CSRF)
				if u.IsAdmin() {
					<input type="hidden" name="role" value="user"/>
					<button type="submit" class="icon-btn" title="Demote to user" aria-label={ "Demote " + u.Name + " to user" }>
						@components.Icon("user", 16)
					</button>
				} else {
					<input type="hidden" name="role" value="admin"/>
					<button type="submit" class="icon-btn" title="Promote to admin" aria-label={ "Promote " + u.Name + " to admin" }>
						@components.Icon("shield", 16)
					</button>
				}
			</form>
			<form method="post" action={ fmt.Sprintf("/admin/users/%d/status", u.ID) }>
				@components.CSRFField(d.CSRF)
				if u.IsActive {
					<input type="hidden" name="active" value="false"/>
					<button type="submit" class="icon-btn" title="Deactivate account" aria-label={ "Deactivate " + u.Name }>
						@components.Icon("lock", 16)
					</button>
				} else {
					<input type="hidden" name="active" value="true"/>
					<button type="submit" class="icon-btn" title="Activate account" aria-label={ "Activate " + u.Name }>
						@components.Icon("check", 16)
					</button>
				}
			</form>
			<form method="post" action={ fmt.Sprintf("/admin/users/%d/delete", u.ID) } data-confirm={ "Delete " + u.Name + "? This can't be undone." }>
				@components.CSRFField(d.CSRF)
				<button type="submit" class="icon-btn danger" title="Delete user" aria-label={ "Delete " + u.Name }>
					@components.Icon("trash", 16)
				</button>
			</form>
		</div>
	}
}
